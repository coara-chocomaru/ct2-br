type eeh;
type eeh_device;
type eeh_exec;
type eeh_tmpfs;

allow atcmdsrv eeh_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow debuggerd eeh:process { ptrace };
allow eeh eeh_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow eeh eeh_exec:file { entrypoint execute getattr open read };
allow eeh eeh_tmpfs:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow hawk eeh:dir { getattr search };
allow hawk eeh:file { open read };
allow init eeh:process { noatsecure rlimitinh siginh transition };
allow init eeh_exec:file { execute getattr open read };
allow init eeh_tmpfs:blk_file { relabelto };
allow init eeh_tmpfs:chr_file { relabelto };
allow init eeh_tmpfs:dir { relabelto };
allow init eeh_tmpfs:fifo_file { relabelto };
allow init eeh_tmpfs:file { relabelto };
allow init eeh_tmpfs:lnk_file { relabelto };
allow init eeh_tmpfs:sock_file { relabelto };
allow marvelltel eeh_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow marvelltel eeh_exec:file { execute execute_no_trans getattr open read };
allow recovery eeh_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow shell eeh_device:chr_file { getattr };
allow shell eeh_exec:file { getattr };
allow unconfineddomain eeh:binder { call set_context_mgr transfer };
allow unconfineddomain eeh_device:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain eeh_device:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain eeh_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain eeh_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain eeh_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain eeh_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain eeh_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain eeh_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app eeh_device:chr_file { getattr };
allow untrusted_app eeh_exec:file { execute getattr open read };
allow untrusted_app eeh_tmpfs:file { getattr };
dontaudit init eeh:process { noatsecure };
