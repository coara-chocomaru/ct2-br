
allow debuggerd touch_updater:process { ptrace };
allow hawk touch_updater:dir { getattr search };
allow hawk touch_updater:file { open read };
allow init touch_updater:file { execute execute_no_trans getattr };
allow init touch_updater:process { noatsecure rlimitinh siginh transition };
allow init touch_updater_exec:file { execute getattr open read };
allow init touch_updater_tmpfs:blk_file { relabelto };
allow init touch_updater_tmpfs:chr_file { relabelto };
allow init touch_updater_tmpfs:dir { relabelto };
allow init touch_updater_tmpfs:fifo_file { relabelto };
allow init touch_updater_tmpfs:file { relabelto };
allow init touch_updater_tmpfs:lnk_file { relabelto };
allow init touch_updater_tmpfs:sock_file { relabelto };
allow recovery touch_updater_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow touch_updater touch_updater_exec:file { entrypoint execute getattr open read };
allow touch_updater touch_updater_tmpfs:file { read write };
allow unconfineddomain touch_updater:binder { call set_context_mgr transfer };
allow unconfineddomain touch_updater_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain touch_updater_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain touch_updater_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain touch_updater_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain touch_updater_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain touch_updater_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app touch_updater_exec:file { execute getattr open read };
dontaudit init touch_updater:process { noatsecure };
