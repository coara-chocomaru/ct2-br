
allow atcmdsrv atcmdsrv_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow atcmdsrv atcmdsrv_exec:file { entrypoint execute getattr open read };
allow atcmdsrv atcmdsrv_tmpfs:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow debuggerd atcmdsrv:process { ptrace };
allow diag atcmdsrv:unix_stream_socket { accept acceptfrom append bind connect connectto create getattr getopt ioctl listen lock name_bind newconn read recv_msg recvfrom send_msg sendto setattr setopt shutdown write };
allow eeh atcmdsrv_tmpfs:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow hawk atcmdsrv:dir { getattr search };
allow hawk atcmdsrv:file { open read };
allow hawk atcmdsrv:unix_stream_socket { connectto };
allow init atcmdsrv:process { noatsecure rlimitinh siginh transition };
allow init atcmdsrv_exec:file { execute getattr open read };
allow init atcmdsrv_tmpfs:blk_file { relabelto };
allow init atcmdsrv_tmpfs:chr_file { relabelto };
allow init atcmdsrv_tmpfs:dir { relabelto };
allow init atcmdsrv_tmpfs:fifo_file { relabelto };
allow init atcmdsrv_tmpfs:file { relabelto };
allow init atcmdsrv_tmpfs:lnk_file { relabelto };
allow init atcmdsrv_tmpfs:sock_file { relabelto };
allow marvelltel atcmdsrv_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow marvelltel atcmdsrv_exec:file { execute execute_no_trans getattr open read };
allow pppmodem atcmdsrv:unix_stream_socket { accept acceptfrom append bind connect connectto create getattr getopt ioctl listen lock name_bind newconn read recv_msg recvfrom send_msg sendto setattr setopt shutdown write };
allow recovery atcmdsrv_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow rild atcmdsrv:unix_stream_socket { accept acceptfrom append bind connect connectto create getattr getopt ioctl listen lock name_bind newconn read recv_msg recvfrom send_msg sendto setattr setopt shutdown write };
allow shell atcmdsrv_device:chr_file { getattr };
allow shell atcmdsrv_exec:file { getattr };
allow system_server atcmdsrv:unix_stream_socket { accept acceptfrom append bind connect connectto create getattr getopt ioctl listen lock name_bind newconn read recv_msg recvfrom send_msg sendto setattr setopt shutdown write };
allow unconfineddomain atcmdsrv:binder { call set_context_mgr transfer };
allow unconfineddomain atcmdsrv_device:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain atcmdsrv_device:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain atcmdsrv_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain atcmdsrv_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain atcmdsrv_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain atcmdsrv_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain atcmdsrv_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain atcmdsrv_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app atcmdsrv_device:chr_file { getattr };
allow untrusted_app atcmdsrv_exec:file { execute getattr open read };
allow untrusted_app atcmdsrv_tmpfs:file { getattr };
dontaudit init atcmdsrv:process { noatsecure };
