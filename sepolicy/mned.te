type mned;
type mned_exec;
type mned_tmpfs;

allow debuggerd mned:process { ptrace };
allow hawk mned:dir { getattr search };
allow hawk mned:file { open read };
allow init mned:process { noatsecure rlimitinh siginh transition };
allow init mned_exec:file { execute getattr open read };
allow init mned_tmpfs:blk_file { relabelto };
allow init mned_tmpfs:chr_file { relabelto };
allow init mned_tmpfs:dir { relabelto };
allow init mned_tmpfs:fifo_file { relabelto };
allow init mned_tmpfs:file { relabelto };
allow init mned_tmpfs:lnk_file { relabelto };
allow init mned_tmpfs:sock_file { relabelto };
allow marvelltel mned:lnk_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow mned mned_exec:file { entrypoint execute getattr open read };
allow mned mned_tmpfs:file { read write };
allow nfc mned:unix_stream_socket { accept acceptfrom append bind connect connectto create getattr getopt ioctl listen lock name_bind newconn read recv_msg recvfrom send_msg sendto setattr setopt shutdown write };
allow recovery mned_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow unconfineddomain mned:binder { call set_context_mgr transfer };
allow unconfineddomain mned_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mned_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain mned_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mned_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mned_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mned_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app mned_exec:file { execute getattr open read };
dontaudit init mned:process { noatsecure };
