
allow debuggerd mlaninit:process { ptrace };
allow init mlaninit:process { noatsecure rlimitinh siginh transition };
allow init mlaninit_exec:file { execute getattr open read };
allow init mlaninit_tmpfs:blk_file { relabelto };
allow init mlaninit_tmpfs:chr_file { relabelto };
allow init mlaninit_tmpfs:dir { relabelto };
allow init mlaninit_tmpfs:fifo_file { relabelto };
allow init mlaninit_tmpfs:file { relabelto };
allow init mlaninit_tmpfs:lnk_file { relabelto };
allow init mlaninit_tmpfs:sock_file { relabelto };
allow mlaninit mlaninit_exec:file { entrypoint execute getattr open read };
allow mlaninit mlaninit_tmpfs:file { read write };
allow recovery mlaninit_exec:file { open setattr write };
allow unconfineddomain mlaninit:binder { call set_context_mgr transfer };
allow unconfineddomain mlaninit_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mlaninit_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain mlaninit_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mlaninit_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mlaninit_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mlaninit_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
dontaudit init mlaninit:process { noatsecure };
