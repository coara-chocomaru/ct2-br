# create new domain codecIPC_server
type codecIPC_server, domain;
type codecIPC_server_exec, exec_type, file_type;
init_daemon_domain(codecIPC_server)
type_transition init codecIPC_server_exec:process codecIPC_server;


#neverallow Google CTS-android-m-preview: 
#neverallow { domain -servicemanager } *:binder set_context_mgr
#allow codecIPC_server servicemanager:binder { transfer call impersonate set_context_mgr };
allow codecIPC_server servicemanager:binder { transfer call impersonate };

#SEC removed: allow codecIPC_server system_server_service:service_manager add;
allow codecIPC_server dumpstate:fd use;
allow codecIPC_server dumpstate:unix_stream_socket { read write getattr getopt setopt shutdown };

#neverallow Google CTS-android-m-preview: 
#neverallow { domain -system_server -system_app -init -installd } system_data_file:file { append create link unlink relabelfrom rename setattr write }
#allow codecIPC_server system_data_file:file create_file_perms;
allow codecIPC_server system_data_file:file r_file_perms;

allow codecIPC_server shell:fd use;
allow codecIPC_server fuse:file create_file_perms;

allow codecIPC_server mrvlgpu_device:chr_file { open read write ioctl getattr lock append };

allow codecIPC_server codecIPC_server_exec:file { read getattr execute entrypoint open };
allow codecIPC_server codecIPC_server_tmpfs:file { read write };
allow init codecIPC_server:process { transition noatsecure siginh rlimitinh };
allow init codecIPC_server_exec:file { read getattr execute open };
allow init codecIPC_server_tmpfs:blk_file { relabelto };
allow init codecIPC_server_tmpfs:chr_file { relabelto };
allow init codecIPC_server_tmpfs:dir { relabelto };
allow init codecIPC_server_tmpfs:fifo_file { relabelto };
allow init codecIPC_server_tmpfs:file { relabelto };
allow init codecIPC_server_tmpfs:lnk_file { relabelto };
allow init codecIPC_server_tmpfs:sock_file { relabelto };
allow recovery codecIPC_server_exec:file { read write create getattr setattr relabelfrom relabelto unlink open };
allow servicemanager codecIPC_server:dir { ioctl read write create getattr setattr unlink link rename add_name remove_name reparent search rmdir open };
allow servicemanager codecIPC_server:file { ioctl read write create getattr setattr lock append unlink link rename open };
allow servicemanager codecIPC_server:process { getattr };
allow shell codecIPC_server:binder { call };
allow shell codecIPC_server_exec:file { getattr };
allow unconfineddomain codecIPC_server:binder { call set_context_mgr transfer };
allow unconfineddomain codecIPC_server_tmpfs:chr_file { ioctl read write create getattr setattr lock relabelfrom append unlink link rename swapon quotaon mounton open audit_access };
allow unconfineddomain codecIPC_server_tmpfs:dir { ioctl read write create getattr setattr lock relabelfrom append unlink link rename execute swapon quotaon mounton add_name remove_name reparent search rmdir open audit_access execmod };
allow unconfineddomain codecIPC_server_tmpfs:fifo_file { ioctl read write create getattr setattr lock relabelfrom append unlink link rename execute swapon quotaon mounton open audit_access execmod };
allow unconfineddomain codecIPC_server_tmpfs:file { ioctl read write create getattr setattr lock relabelfrom append unlink link rename swapon quotaon mounton open audit_access };
allow unconfineddomain codecIPC_server_tmpfs:lnk_file { ioctl read write create getattr setattr lock relabelfrom append unlink link rename execute swapon quotaon mounton open audit_access execmod };
allow unconfineddomain codecIPC_server_tmpfs:sock_file { ioctl read write create getattr setattr lock relabelfrom append unlink link rename execute swapon quotaon mounton open audit_access execmod };
allow untrusted_app codecIPC_server_exec:file { read getattr execute open };

#ipc
allow shell ipc_device:chr_file { getattr };
allow system_server ipc_device:chr_file { ioctl read write create getattr setattr lock append unlink link rename open };
allow unconfineddomain ipc_device:chr_file { ioctl read write create getattr setattr lock relabelfrom append unlink link rename swapon quotaon mounton open audit_access };
allow unconfineddomain ipc_device:file { ioctl read write create getattr setattr lock relabelfrom append unlink link rename swapon quotaon mounton open audit_access };
allow untrusted_app ipc_device:chr_file { getattr };
