type infor_device;

allow iml infor_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow mediaserver infor_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow radio infor_device:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow shell infor_device:chr_file { getattr };
allow unconfineddomain infor_device:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain infor_device:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app infor_device:chr_file { getattr read };
