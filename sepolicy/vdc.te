allow debuggerd vdc:process { ptrace };
allow dumpstate vdc:process { rlimitinh siginh signal transition };
allow dumpstate vdc_exec:file { execute getattr open read };
allow init vdc:process { noatsecure rlimitinh siginh transition };
allow init vdc_exec:file { execute getattr open read };
allow init vdc_tmpfs:blk_file { relabelto };
allow init vdc_tmpfs:chr_file { relabelto };
allow init vdc_tmpfs:dir { relabelto };
allow init vdc_tmpfs:fifo_file { relabelto };
allow init vdc_tmpfs:file { relabelto };
allow init vdc_tmpfs:lnk_file { relabelto };
allow init vdc_tmpfs:sock_file { relabelto };
allow recovery vdc_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow shell vdc_exec:file { getattr };
allow unconfineddomain vdc:binder { call set_context_mgr transfer };
allow unconfineddomain vdc_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain vdc_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain vdc_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain vdc_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain vdc_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain vdc_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app vdc_exec:file { execute getattr open read };
allow vdc vdc_exec:file { entrypoint execute getattr open read };
dontaudit dumpstate vdc:process { noatsecure };
dontaudit init vdc:process { noatsecure };
