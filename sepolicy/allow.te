
# --- mwirelessd ---
allow mwirelessd wifi_data_file:dir { ioctl read write create getattr setattr lock relabelfrom relabelto append unlink link rename add_name remove_name reparent search rmdir open };
# wifi_data_file (file, sock, lnk, fifo, chr, blk)
allow mwirelessd wifi_data_file:file { ioctl read write create getattr setattr lock relabelfrom relabelto append unlink link rename open };
allow mwirelessd wifi_data_file:sock_file { ioctl read write create getattr setattr lock relabelfrom relabelto append unlink link rename open };
allow mwirelessd wifi_data_file:lnk_file { ioctl read write create getattr setattr lock relabelfrom relabelto append unlink link rename open };
allow mwirelessd wifi_data_file:fifo_file { ioctl read write create getattr setattr lock relabelfrom relabelto append unlink link rename open };
allow mwirelessd wifi_data_file:chr_file { ioctl read write create getattr setattr lock relabelfrom relabelto append unlink link rename open };
allow mwirelessd wifi_data_file:blk_file { ioctl read write create getattr setattr lock relabelfrom relabelto append unlink link rename open };

# wpa_socket
allow mwirelessd wpa_socket:dir { ioctl read write create getattr setattr lock relabelfrom relabelto append unlink link rename add_name remove_name reparent search rmdir open };
allow mwirelessd wpa_socket:sock_file { ioctl read write create getattr setattr lock relabelfrom relabelto append unlink link rename open };
allow mwirelessd wpa_socket:file { ioctl read write create getattr setattr lock relabelfrom relabelto append unlink link rename open };
allow mwirelessd wpa_socket:lnk_file { ioctl read write create getattr setattr lock relabelfrom relabelto append unlink link rename open };
allow mwirelessd wpa_socket:fifo_file { ioctl read write create getattr setattr lock relabelfrom relabelto append unlink link rename open };
allow mwirelessd wpa_socket:chr_file { ioctl read write create getattr setattr lock relabelfrom relabelto append unlink link rename open };
allow wpa wlan_device:chr_file rw_file_perms;
allow wpa sysfs_wlan_wifi_debug:dir search;
allow wpa mrvl_wifi_prop:property_service set;



