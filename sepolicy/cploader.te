# NOTE: the original source also contained
#   typealias gpu_device alias mrvlgpu_device;
#   typeattribute mrvlgpu_device gpu_device;
# but mrvlgpu_device is already declared as its own type ("type mrvlgpu_device;",
# used directly as an chr_file target throughout galcore.te / cploader.te), so
# aliasing it to gpu_device as well is a duplicate-declaration conflict and was
# removed. If gpu_device grouping is actually required, apply the gpu_device
# attribute to mrvlgpu_device instead (typeattribute only, no typealias).

allow marvelltel cploader_block_device:blk_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow recovery cploader_block_device:blk_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow recovery cploader_block_device:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow shell cploader_block_device:blk_file { getattr };
allow unconfineddomain cploader_block_device:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain cploader_block_device:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app cploader_block_device:blk_file { getattr };
