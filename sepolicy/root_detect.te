
allow debuggerd root_detect:process { ptrace };
allow init root_detect:process { noatsecure rlimitinh siginh transition };
allow init root_detect_exec:file { execute getattr open read };
allow init root_detect_tmpfs:blk_file { relabelto };
allow init root_detect_tmpfs:chr_file { relabelto };
allow init root_detect_tmpfs:dir { relabelto };
allow init root_detect_tmpfs:fifo_file { relabelto };
allow init root_detect_tmpfs:file { relabelto };
allow init root_detect_tmpfs:lnk_file { relabelto };
allow init root_detect_tmpfs:sock_file { relabelto };
allow recovery root_detect_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow root_detect root_detect_exec:file { entrypoint execute getattr open read };
allow root_detect root_detect_tmpfs:file { read write };
allow unconfineddomain root_detect:binder { call set_context_mgr transfer };
allow unconfineddomain root_detect_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain root_detect_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain root_detect_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain root_detect_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain root_detect_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain root_detect_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
dontaudit init root_detect:process { noatsecure };
