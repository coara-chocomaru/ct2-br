type log_on_boot;
type log_on_boot_exec;
type log_on_boot_tmpfs;

allow debuggerd log_on_boot:process { ptrace };
allow init log_on_boot:process { noatsecure rlimitinh siginh transition };
allow init log_on_boot_exec:file { execute getattr open read };
allow init log_on_boot_tmpfs:blk_file { relabelto };
allow init log_on_boot_tmpfs:chr_file { relabelto };
allow init log_on_boot_tmpfs:dir { relabelto };
allow init log_on_boot_tmpfs:fifo_file { relabelto };
allow init log_on_boot_tmpfs:file { relabelto };
allow init log_on_boot_tmpfs:lnk_file { relabelto };
allow init log_on_boot_tmpfs:sock_file { relabelto };
allow log_on_boot log_on_boot_exec:file { entrypoint execute getattr open read };
allow log_on_boot log_on_boot_tmpfs:file { read write };
allow recovery log_on_boot_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow shell log_on_boot_exec:file { getattr };
allow unconfineddomain log_on_boot:binder { call set_context_mgr transfer };
allow unconfineddomain log_on_boot_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain log_on_boot_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain log_on_boot_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain log_on_boot_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain log_on_boot_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain log_on_boot_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app log_on_boot_exec:file { execute getattr open read };
dontaudit init log_on_boot:process { noatsecure };
