type memsic_device;

allow memsicd memsic_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow memsicp memsic_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow shell memsic_device:chr_file { getattr };
allow system_server memsic_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow unconfineddomain memsic_device:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain memsic_device:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app memsic_device:chr_file { getattr };
