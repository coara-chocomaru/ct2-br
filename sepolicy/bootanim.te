allow bootanim bootanim_exec:file { entrypoint execute getattr open read };
allow debuggerd bootanim:process { ptrace };
allow hawk bootanim:dir { getattr search };
allow hawk bootanim:file { open read };
allow init bootanim:process { noatsecure rlimitinh siginh transition };
allow init bootanim_exec:file { execute getattr open read };
allow init bootanim_tmpfs:blk_file { relabelto };
allow init bootanim_tmpfs:chr_file { relabelto };
allow init bootanim_tmpfs:dir { relabelto };
allow init bootanim_tmpfs:fifo_file { relabelto };
allow init bootanim_tmpfs:file { relabelto };
allow init bootanim_tmpfs:lnk_file { relabelto };
allow init bootanim_tmpfs:sock_file { relabelto };
allow recovery bootanim_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow servicemanager bootanim:dir { search };
allow servicemanager bootanim:process { getattr };
allow shell bootanim_exec:file { getattr };
allow surfaceflinger bootanim:fd { use };
allow unconfineddomain bootanim:binder { call set_context_mgr transfer };
allow unconfineddomain bootanim_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain bootanim_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain bootanim_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain bootanim_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain bootanim_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain bootanim_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app bootanim_exec:file { execute getattr open read };
dontaudit init bootanim:process { noatsecure };
