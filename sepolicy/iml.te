
allow debuggerd iml:process { ptrace };
allow hawk iml:dir { getattr search };
allow hawk iml:file { open read };
allow iml iml_exec:file { entrypoint execute getattr open read };
allow iml iml_tmpfs:file { read write };
allow init iml:process { noatsecure rlimitinh siginh transition };
allow init iml_exec:file { execute getattr open read };
allow init iml_tmpfs:blk_file { relabelto };
allow init iml_tmpfs:chr_file { relabelto };
allow init iml_tmpfs:dir { relabelto };
allow init iml_tmpfs:fifo_file { relabelto };
allow init iml_tmpfs:file { relabelto };
allow init iml_tmpfs:lnk_file { relabelto };
allow init iml_tmpfs:sock_file { relabelto };
allow radio iml:unix_stream_socket { accept acceptfrom append bind connect connectto create getattr getopt ioctl listen lock name_bind newconn read recv_msg recvfrom send_msg sendto setattr setopt shutdown write };
allow recovery iml_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow shell iml_exec:file { getattr };
allow unconfineddomain iml:binder { call set_context_mgr transfer };
allow unconfineddomain iml_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain iml_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain iml_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain iml_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain iml_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain iml_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app iml_exec:file { execute getattr open read };
dontaudit init iml:process { noatsecure };
