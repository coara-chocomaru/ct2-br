type core_compressor;
type core_compressor_exec;

allow core_compressor core_compressor_exec:file { entrypoint execute getattr open read };
allow debuggerd core_compressor:process { ptrace };
allow init core_compressor:process { noatsecure };
allow kernel core_compressor:process { rlimitinh siginh transition };
allow kernel core_compressor_exec:file { execute getattr open read };
allow recovery core_compressor_exec:file { getattr open read relabelto setattr unlink write };
allow unconfineddomain core_compressor:binder { call set_context_mgr transfer };
allow untrusted_app core_compressor_exec:file { execute getattr open read };
dontaudit kernel core_compressor:process { noatsecure };
