
allow at_router at_router_exec:file { entrypoint execute getattr open read };
allow at_router at_router_tmpfs:file { read write };
allow debuggerd at_router:process { ptrace };
allow init at_router:process { noatsecure rlimitinh siginh transition };
allow init at_router_exec:file { execute getattr open read };
allow init at_router_tmpfs:blk_file { relabelto };
allow init at_router_tmpfs:chr_file { relabelto };
allow init at_router_tmpfs:dir { relabelto };
allow init at_router_tmpfs:fifo_file { relabelto };
allow init at_router_tmpfs:file { relabelto };
allow init at_router_tmpfs:lnk_file { relabelto };
allow init at_router_tmpfs:sock_file { relabelto };
allow radio at_router:unix_stream_socket { accept acceptfrom append bind connect connectto create getattr getopt ioctl listen lock name_bind newconn read recv_msg recvfrom send_msg sendto setattr setopt shutdown write };
allow unconfineddomain at_router:binder { call set_context_mgr transfer };
allow unconfineddomain at_router_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain at_router_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain at_router_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain at_router_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain at_router_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain at_router_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
dontaudit init at_router:process { noatsecure };
