allow debuggerd lmkd:process { ptrace };
allow hawk lmkd:dir { getattr search };
allow hawk lmkd:file { open read };
allow init lmkd:process { rlimitinh siginh transition };
allow init lmkd_exec:file { execute getattr open read };
allow init lmkd_socket:blk_file { relabelto };
allow init lmkd_socket:chr_file { relabelto };
allow init lmkd_socket:dir { relabelto };
allow init lmkd_socket:fifo_file { relabelto };
allow init lmkd_socket:file { relabelto };
allow init lmkd_socket:lnk_file { relabelto };
allow init lmkd_socket:sock_file { relabelto };
allow init lmkd_tmpfs:blk_file { relabelto };
allow init lmkd_tmpfs:chr_file { relabelto };
allow init lmkd_tmpfs:dir { relabelto };
allow init lmkd_tmpfs:fifo_file { relabelto };
allow init lmkd_tmpfs:file { relabelto };
allow init lmkd_tmpfs:lnk_file { relabelto };
allow init lmkd_tmpfs:sock_file { relabelto };
allow lmkd lmkd_exec:file { entrypoint execute getattr open read };
allow marvelltel lmkd:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow marvelltel lmkd:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow marvelltel lmkd:lnk_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow recovery lmkd_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow shell lmkd_exec:file { getattr };
allow system_server lmkd:unix_stream_socket { connectto };
allow system_server lmkd_socket:sock_file { write };
allow unconfineddomain lmkd:binder { call set_context_mgr transfer };
allow unconfineddomain lmkd_socket:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain lmkd_socket:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain lmkd_socket:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain lmkd_socket:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain lmkd_socket:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain lmkd_socket:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain lmkd_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain lmkd_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain lmkd_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain lmkd_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain lmkd_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain lmkd_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app lmkd_exec:file { execute getattr open read };
allow untrusted_app lmkd_socket:sock_file { getattr };
dontaudit init lmkd:process { noatsecure };
