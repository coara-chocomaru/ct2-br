
allow debuggerd kinitlog:process { ptrace };
allow init kinitlog:process { noatsecure rlimitinh siginh transition };
allow init kinitlog_exec:file { execute getattr open read };
allow init kinitlog_tmpfs:blk_file { relabelto };
allow init kinitlog_tmpfs:chr_file { relabelto };
allow init kinitlog_tmpfs:dir { relabelto };
allow init kinitlog_tmpfs:fifo_file { relabelto };
allow init kinitlog_tmpfs:file { relabelto };
allow init kinitlog_tmpfs:lnk_file { relabelto };
allow init kinitlog_tmpfs:sock_file { relabelto };
allow kinitlog kinitlog_exec:file { entrypoint execute getattr open read };
allow kinitlog kinitlog_tmpfs:file { read write };
allow recovery kinitlog_exec:file { create getattr open relabelfrom relabelto setattr write };
allow shell kinitlog_exec:file { getattr };
allow unconfineddomain kinitlog:binder { call set_context_mgr transfer };
allow unconfineddomain kinitlog_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain kinitlog_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain kinitlog_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain kinitlog_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain kinitlog_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain kinitlog_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app kinitlog_exec:file { execute getattr open read };
dontaudit init kinitlog:process { noatsecure };
