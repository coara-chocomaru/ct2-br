
allow debuggerd kmsg:process { ptrace };
allow hawk kmsg:dir { getattr search };
allow hawk kmsg:file { open read };
allow init kmsg:process { noatsecure rlimitinh siginh transition };
allow init kmsg_exec:file { execute getattr open read };
allow init kmsg_tmpfs:blk_file { relabelto };
allow init kmsg_tmpfs:chr_file { relabelto };
allow init kmsg_tmpfs:dir { relabelto };
allow init kmsg_tmpfs:fifo_file { relabelto };
allow init kmsg_tmpfs:file { relabelto };
allow init kmsg_tmpfs:lnk_file { relabelto };
allow init kmsg_tmpfs:sock_file { relabelto };
allow kmsg kmsg_exec:file { entrypoint execute getattr open read };
allow kmsg kmsg_tmpfs:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow logd kmsg_device:chr_file { append open write };
allow marvelltel kmsg_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow marvelltel kmsg_device:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow recovery kmsg_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow servicemanager kmsg_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow shell kmsg_device:chr_file { getattr };
allow system_server kmsg_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow unconfineddomain kmsg:binder { call set_context_mgr transfer };
allow unconfineddomain kmsg_device:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain kmsg_device:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain kmsg_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain kmsg_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain kmsg_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain kmsg_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain kmsg_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain kmsg_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app kmsg_device:chr_file { getattr };
allow untrusted_app kmsg_exec:file { execute getattr open read };
allow untrusted_app kmsg_tmpfs:file { getattr };
dontaudit init kmsg:process { noatsecure };
