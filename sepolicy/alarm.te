allow domain alarm_device:chr_file { getattr ioctl lock open read };
allow radio alarm_device:chr_file { append getattr ioctl lock open read write };
allow rild alarm_device:chr_file { append getattr ioctl lock open read write };
allow system_server alarm_device:chr_file { append getattr ioctl lock open read write };
allow unconfineddomain alarm_device:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain alarm_device:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
