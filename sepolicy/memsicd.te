
allow debuggerd memsicd:process { ptrace };
allow init memsicd:process { noatsecure rlimitinh siginh transition };
allow init memsicd_exec:file { execute getattr open read };
allow init memsicd_tmpfs:blk_file { relabelto };
allow init memsicd_tmpfs:chr_file { relabelto };
allow init memsicd_tmpfs:dir { relabelto };
allow init memsicd_tmpfs:fifo_file { relabelto };
allow init memsicd_tmpfs:file { relabelto };
allow init memsicd_tmpfs:lnk_file { relabelto };
allow init memsicd_tmpfs:sock_file { relabelto };
allow memsicd memsicd_exec:file { entrypoint execute getattr open read };
allow memsicd memsicd_tmpfs:file { read write };
allow unconfineddomain memsicd:binder { call set_context_mgr transfer };
allow unconfineddomain memsicd_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain memsicd_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain memsicd_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain memsicd_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain memsicd_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain memsicd_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app memsicd_exec:file { execute getattr open read };
dontaudit init memsicd:process { noatsecure };
