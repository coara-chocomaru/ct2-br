
allow FMRadiod mediaserver:binder { call transfer };
allow appdomain mediaserver:binder { transfer };
allow binderservicedomain mediaserver:binder { transfer };
allow debuggerd mediaserver:process { ptrace };
allow drmserver mediaserver:fd { use };
allow dumpstate mediaserver:process { signal };
allow dumpstate mediaserver_exec:file { getattr ioctl lock open read };
allow hawk mediaserver:dir { getattr search };
allow hawk mediaserver:file { open read };
allow init mediaserver:process { noatsecure rlimitinh siginh transition };
allow init mediaserver_exec:file { execute getattr open read };
allow init mediaserver_tmpfs:blk_file { relabelto };
allow init mediaserver_tmpfs:chr_file { relabelto };
allow init mediaserver_tmpfs:dir { relabelto };
allow init mediaserver_tmpfs:fifo_file { relabelto };
allow init mediaserver_tmpfs:file { relabelto };
allow init mediaserver_tmpfs:lnk_file { relabelto };
allow init mediaserver_tmpfs:sock_file { relabelto };
allow marvelltel mediaserver:lnk_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow mediaserver mediaserver_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow mediaserver mediaserver_exec:file { entrypoint execute getattr open read };
allow recovery mediaserver_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow servicemanager mediaserver:dir { search };
allow servicemanager mediaserver:process { getattr };
allow shell mediaserver_device:chr_file { getattr };
allow shell mediaserver_exec:file { getattr };
allow system_server mediaserver:dir { getattr ioctl open read search };
allow system_server mediaserver:file { getattr ioctl lock open read };
allow system_server mediaserver:lnk_file { getattr ioctl lock open read };
allow system_server mediaserver:tcp_socket { append bind connect getattr getopt ioctl lock read setattr setopt shutdown write };
allow system_server mediaserver:udp_socket { append bind connect getattr getopt ioctl lock read setattr setopt shutdown write };
allow unconfineddomain mediaserver:binder { call set_context_mgr transfer };
allow unconfineddomain mediaserver_device:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mediaserver_device:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mediaserver_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mediaserver_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain mediaserver_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mediaserver_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mediaserver_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mediaserver_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app mediaserver_device:chr_file { getattr };
allow untrusted_app mediaserver_exec:file { execute getattr open read };
dontaudit init mediaserver:process { noatsecure };
