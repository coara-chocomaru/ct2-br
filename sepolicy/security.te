type security_block_device;

allow debuggerd security_file:dir { getattr ioctl open read search };
allow debuggerd security_file:file { getattr ioctl lock open read };
allow domain security_file:dir { getattr search };
allow domain security_file:file { getattr };
allow domain security_file:lnk_file { getattr ioctl lock open read };
allow init security_file:blk_file { relabelto };
allow init security_file:chr_file { relabelto };
allow init security_file:dir { create getattr ioctl open read relabelto search setattr };
allow init security_file:fifo_file { relabelto };
allow init security_file:file { getattr ioctl lock open read relabelto };
allow init security_file:lnk_file { getattr ioctl lock open read relabelto };
allow init security_file:sock_file { relabelto };
allow init security_prop:property_service { set };
allow installd security_file:dir { getattr ioctl open read search };
allow installd security_file:file { getattr ioctl lock open read };
allow runas security_file:dir { getattr ioctl open read search };
allow runas security_file:file { getattr ioctl lock open read };
allow shell security_block_device:blk_file { getattr };
allow system_server security_file:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow system_server security_file:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow system_server security_file:lnk_file { create rename unlink };
allow system_server security_prop:property_service { set };
allow ueventd security_file:dir { getattr ioctl open read search };
allow ueventd security_file:file { getattr ioctl lock open read };
allow unconfineddomain security_block_device:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain security_block_device:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app security_block_device:blk_file { getattr };
allow vold security_file:dir { getattr ioctl open read search };
allow vold security_file:file { getattr ioctl lock open read };
allow zygote security_file:dir { getattr ioctl open read search };
allow zygote security_file:file { getattr ioctl lock open read };
