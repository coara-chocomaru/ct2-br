type mlan2040coex;
type mlan2040coex_exec;
type mlan2040coex_tmpfs;

allow debuggerd mlan2040coex:process { ptrace };
allow init mlan2040coex:process { noatsecure rlimitinh siginh transition };
allow init mlan2040coex_exec:file { execute getattr open read };
allow init mlan2040coex_tmpfs:blk_file { relabelto };
allow init mlan2040coex_tmpfs:chr_file { relabelto };
allow init mlan2040coex_tmpfs:dir { relabelto };
allow init mlan2040coex_tmpfs:fifo_file { relabelto };
allow init mlan2040coex_tmpfs:file { relabelto };
allow init mlan2040coex_tmpfs:lnk_file { relabelto };
allow init mlan2040coex_tmpfs:sock_file { relabelto };
allow mlan2040coex mlan2040coex_exec:file { entrypoint execute getattr open read };
allow mlan2040coex mlan2040coex_tmpfs:file { read write };
allow recovery mlan2040coex_exec:file { open setattr write };
allow system_server mlan2040coex:unix_stream_socket { accept acceptfrom append bind connect connectto create getattr getopt ioctl listen lock name_bind newconn read recv_msg recvfrom send_msg sendto setattr setopt shutdown write };
allow unconfineddomain mlan2040coex:binder { call set_context_mgr transfer };
allow unconfineddomain mlan2040coex_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mlan2040coex_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain mlan2040coex_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mlan2040coex_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mlan2040coex_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mlan2040coex_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
dontaudit init mlan2040coex:process { noatsecure };
