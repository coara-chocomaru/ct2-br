allow debuggerd sdcardd:process { ptrace };
allow dumpstate sdcardd:process { signal };
allow dumpstate sdcardd_exec:file { getattr ioctl lock open read };
allow hawk sdcardd:dir { getattr search };
allow hawk sdcardd:file { open read };
allow init sdcardd:process { noatsecure rlimitinh siginh transition };
allow init sdcardd_exec:file { execute getattr open read };
allow init sdcardd_tmpfs:blk_file { relabelto };
allow init sdcardd_tmpfs:chr_file { relabelto };
allow init sdcardd_tmpfs:dir { relabelto };
allow init sdcardd_tmpfs:fifo_file { relabelto };
allow init sdcardd_tmpfs:file { relabelto };
allow init sdcardd_tmpfs:lnk_file { relabelto };
allow init sdcardd_tmpfs:sock_file { relabelto };
allow recovery sdcardd_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow sdcardd sdcardd_exec:file { entrypoint execute getattr open read };
allow shell sdcardd_exec:file { getattr };
allow system_server sdcardd:dir { getattr ioctl open read search };
allow system_server sdcardd:file { getattr ioctl lock open read };
allow system_server sdcardd:lnk_file { getattr ioctl lock open read };
allow unconfineddomain sdcardd:binder { call set_context_mgr transfer };
allow unconfineddomain sdcardd_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain sdcardd_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain sdcardd_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain sdcardd_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain sdcardd_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain sdcardd_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app sdcardd_exec:file { execute getattr open read };
dontaudit init sdcardd:process { noatsecure };
