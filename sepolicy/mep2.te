
allow recovery mep2_block_device:blk_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow recovery mep2_block_device:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow shell mep2_block_device:blk_file { getattr };
allow unconfineddomain mep2_block_device:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mep2_block_device:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app mep2_block_device:blk_file { getattr };
