
allow debuggerd marvelltel:process { ptrace };
allow eeh marvelltel_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow eeh marvelltel_tmpfs:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow hawk marvelltel:dir { getattr search };
allow hawk marvelltel:file { open read };
allow init marvelltel:process { noatsecure rlimitinh siginh transition };
allow init marvelltel_tmpfs:blk_file { relabelto };
allow init marvelltel_tmpfs:chr_file { relabelto };
allow init marvelltel_tmpfs:dir { relabelto };
allow init marvelltel_tmpfs:fifo_file { relabelto };
allow init marvelltel_tmpfs:file { relabelto };
allow init marvelltel_tmpfs:lnk_file { relabelto };
allow init marvelltel_tmpfs:sock_file { relabelto };
allow marvelltel marvelltel_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow marvelltel marvelltel_tmpfs:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow shell marvelltel_device:chr_file { getattr };
allow unconfineddomain marvelltel:binder { call set_context_mgr transfer };
allow unconfineddomain marvelltel_device:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain marvelltel_device:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain marvelltel_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain marvelltel_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain marvelltel_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain marvelltel_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain marvelltel_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain marvelltel_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app marvelltel_device:chr_file { getattr };
allow untrusted_app marvelltel_tmpfs:file { getattr };
dontaudit init marvelltel:process { noatsecure };
