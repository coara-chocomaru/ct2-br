# NVM storage label
type nvm_data_file, file_type;

# Broad Marvell GPU access for bring-up.
# Keep app domains out to avoid the most common neverallow failures.
allow { domain -appdomain -isolated_app -untrusted_app -platform_app -system_app } mrvlgpu_device:chr_file { open read write ioctl getattr lock append };
allow shell mrvlgpu_device:chr_file { open read write ioctl getattr lock append };
allow dumpstate mrvlgpu_device:chr_file { open read write ioctl getattr lock append };
allow init mrvlgpu_device:chr_file { open read write ioctl getattr lock append };
