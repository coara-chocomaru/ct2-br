# define new device type
#SEC changed : use alias, type mediaserver_device, dev_type;
type mediaserver_device, dev_type;
# typealias camera_device alias mediaserver_device;
type i2c_device, dev_type;
#SEC removed: no need, type system_app_device, dev_type;
type nvm_device, dev_type;
#SEC removed: conflict, type diag_device, dev_type;
type atcmdsrv_device, dev_type;
type eeh_device, dev_type;
type pppmodem_device, dev_type;
type marvelltel_device, dev_type;
#SEC changed : conflict, use tz_device type teecsstdca_device, dev_type;
#SEC removed: conflict, type bluetooth_device, dev_type;
#SEC removed: conflict, type i2c_device, dev_type;
type wpa_device, dev_type;
#SEC changed : type mrvlgpu_device, dev_type;
type mrvlgpu_device, dev_type;
#typealias gpu_device alias mrvlgpu_device;
type mwireless_device, dev_type;
type memsic_device, dev_type;
type geu_device, dev_type;
type ipc_device, dev_type;
type vpu_device, dev_type;
type infor_device, dev_type;
#SEC_SELinux conflict: type ssipc_device, dev_type;

# new block device
#SEC changed : use alias, type cploader_block_device, dev_type;

type cploader_block_device, dev_type;

allow recovery cploader_block_device:blk_file { ioctl read write create getattr setattr lock append unlink link rename open };
allow recovery cploader_block_device:dir { ioctl read write create getattr setattr unlink link rename add_name remove_name reparent search rmdir open };
allow shell cploader_block_device:blk_file { getattr };
allow unconfineddomain cploader_block_device:chr_file { ioctl read write create getattr setattr lock relabelfrom append unlink link rename swapon quotaon mounton open audit_access };
allow unconfineddomain cploader_block_device:file { ioctl read write create getattr setattr lock relabelfrom append unlink link rename swapon quotaon mounton open audit_access };
allow untrusted_app cploader_block_device:blk_file { getattr };


