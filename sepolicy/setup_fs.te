type setup_fs;
type setup_fs_exec;
type setup_fs_tmpfs;

allow debuggerd setup_fs:process { ptrace };
allow init setup_fs:process { noatsecure rlimitinh siginh transition };
allow init setup_fs_exec:file { execute getattr open read };
allow init setup_fs_tmpfs:blk_file { relabelto };
allow init setup_fs_tmpfs:chr_file { relabelto };
allow init setup_fs_tmpfs:dir { relabelto };
allow init setup_fs_tmpfs:fifo_file { relabelto };
allow init setup_fs_tmpfs:file { relabelto };
allow init setup_fs_tmpfs:lnk_file { relabelto };
allow init setup_fs_tmpfs:sock_file { relabelto };
allow recovery setup_fs_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow setup_fs setup_fs_exec:file { entrypoint execute getattr open read };
allow setup_fs setup_fs_tmpfs:file { read write };
allow shell setup_fs_exec:file { getattr };
allow unconfineddomain setup_fs:binder { call set_context_mgr transfer };
allow unconfineddomain setup_fs_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain setup_fs_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain setup_fs_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain setup_fs_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain setup_fs_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain setup_fs_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app setup_fs_exec:file { execute getattr open read };
dontaudit init setup_fs:process { noatsecure };
