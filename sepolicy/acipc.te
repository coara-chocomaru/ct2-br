type ipc_device;

allow mrvl_gpsd ipc_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow shell ipc_device:chr_file { getattr };
allow system_server ipc_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow unconfineddomain ipc_device:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain ipc_device:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app ipc_device:chr_file { getattr };
