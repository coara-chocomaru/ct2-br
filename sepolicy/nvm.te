allow eeh nvm_data_file:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow eeh nvm_data_file:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow eeh nvm_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow hawk nvm:dir { getattr search };
allow hawk nvm:file { open read };
allow init nvm:process { noatsecure rlimitinh siginh transition };
allow init nvm_data_file:blk_file { relabelto };
allow init nvm_data_file:chr_file { relabelto };
allow init nvm_data_file:dir { relabelto };
allow init nvm_data_file:fifo_file { relabelto };
allow init nvm_data_file:file { relabelto };
allow init nvm_data_file:lnk_file { relabelto };
allow init nvm_data_file:sock_file { relabelto };
allow init nvm_exec:file { execute getattr open read };
allow init nvm_tmpfs:blk_file { relabelto };
allow init nvm_tmpfs:chr_file { relabelto };
allow init nvm_tmpfs:dir { relabelto };
allow init nvm_tmpfs:fifo_file { relabelto };
allow init nvm_tmpfs:file { relabelto };
allow init nvm_tmpfs:lnk_file { relabelto };
allow init nvm_tmpfs:sock_file { relabelto };
allow load_g_cali_data nvm_data_file:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow load_g_cali_data nvm_data_file:file { append create getattr ioctl link lock open read rename setattr unlink write };
