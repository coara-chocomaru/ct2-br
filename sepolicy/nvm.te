allow marvelltel nvm_data_file:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow marvelltel nvm_data_file:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow marvelltel nvm_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow marvelltel nvm_exec:file { execute execute_no_trans getattr open read };
