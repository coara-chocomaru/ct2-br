type nvm;
type nvm_block_device;
type nvm_data_file;
type nvm_device;
type nvm_exec;
type nvm_tmpfs;

allow adbd nvm_block_device:blk_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow adbd nvm_block_device:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow adbd nvm_data_file:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow adbd nvm_data_file:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow atcmdsrv nvm_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow debuggerd nvm:process { ptrace };
allow diag nvm:unix_dgram_socket { accept append bind connect create getattr getopt ioctl listen lock name_bind read recv_msg recvfrom send_msg sendto setattr setopt shutdown write };
allow diag nvm_block_device:blk_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow diag nvm_data_file:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow diag nvm_data_file:file { append create getattr ioctl link lock open read rename setattr unlink write };
