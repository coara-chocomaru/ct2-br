allow recovery nvm_data_file:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow recovery nvm_exec:file { create getattr open read relabelfrom relabelto setattr unlink write };
allow setup_fs nvm_block_device:blk_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow shell nvm_block_device:blk_file { getattr };
allow shell nvm_data_file:dir { getattr };
allow shell nvm_device:chr_file { getattr };
allow shell nvm_exec:file { getattr };
allow system_app nvm_data_file:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow system_app nvm_data_file:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow system_server nvm_data_file:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow unconfineddomain nvm:binder { call set_context_mgr transfer };
allow unconfineddomain nvm_block_device:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
