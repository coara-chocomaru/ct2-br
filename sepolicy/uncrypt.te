allow debuggerd uncrypt:process { ptrace };
allow init uncrypt:process { noatsecure rlimitinh siginh transition };
allow init uncrypt_exec:file { execute getattr open read };
allow init uncrypt_tmpfs:blk_file { relabelto };
allow init uncrypt_tmpfs:chr_file { relabelto };
allow init uncrypt_tmpfs:dir { relabelto };
allow init uncrypt_tmpfs:fifo_file { relabelto };
allow init uncrypt_tmpfs:file { relabelto };
allow init uncrypt_tmpfs:lnk_file { relabelto };
allow init uncrypt_tmpfs:sock_file { relabelto };
allow recovery uncrypt_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow shell uncrypt_exec:file { getattr };
allow unconfineddomain uncrypt:binder { call set_context_mgr transfer };
allow unconfineddomain uncrypt_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain uncrypt_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain uncrypt_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain uncrypt_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain uncrypt_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain uncrypt_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow uncrypt uncrypt_exec:file { entrypoint execute getattr open read };
allow untrusted_app uncrypt_exec:file { getattr };
dontaudit init uncrypt:process { noatsecure };
