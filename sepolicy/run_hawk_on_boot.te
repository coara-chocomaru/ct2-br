type run_hawk_on_boot;
type run_hawk_on_boot_exec;
type run_hawk_on_boot_tmpfs;

allow debuggerd run_hawk_on_boot:process { ptrace };
allow hawk run_hawk_on_boot:dir { getattr search };
allow hawk run_hawk_on_boot:file { open read };
allow init run_hawk_on_boot:file { execute execute_no_trans getattr };
allow init run_hawk_on_boot:process { noatsecure rlimitinh siginh transition };
allow init run_hawk_on_boot_exec:file { execute getattr open read };
allow init run_hawk_on_boot_tmpfs:blk_file { relabelto };
allow init run_hawk_on_boot_tmpfs:chr_file { relabelto };
allow init run_hawk_on_boot_tmpfs:dir { relabelto };
allow init run_hawk_on_boot_tmpfs:fifo_file { relabelto };
allow init run_hawk_on_boot_tmpfs:file { relabelto };
allow init run_hawk_on_boot_tmpfs:lnk_file { relabelto };
allow init run_hawk_on_boot_tmpfs:sock_file { relabelto };
allow recovery run_hawk_on_boot_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow run_hawk_on_boot run_hawk_on_boot_exec:file { entrypoint execute getattr open read };
allow run_hawk_on_boot run_hawk_on_boot_tmpfs:file { read write };
allow unconfineddomain run_hawk_on_boot:binder { call set_context_mgr transfer };
allow unconfineddomain run_hawk_on_boot_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain run_hawk_on_boot_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain run_hawk_on_boot_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain run_hawk_on_boot_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain run_hawk_on_boot_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain run_hawk_on_boot_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app run_hawk_on_boot_exec:file { execute getattr open read };
dontaudit init run_hawk_on_boot:process { noatsecure };
