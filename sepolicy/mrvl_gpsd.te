type mrvl_gpsd;
type mrvl_gpsd_exec;
type mrvl_gpsd_tmpfs;

allow debuggerd mrvl_gpsd:process { ptrace };
allow init mrvl_gpsd:process { noatsecure rlimitinh siginh transition };
allow init mrvl_gpsd_exec:file { execute getattr open read };
allow init mrvl_gpsd_tmpfs:blk_file { relabelto };
allow init mrvl_gpsd_tmpfs:chr_file { relabelto };
allow init mrvl_gpsd_tmpfs:dir { relabelto };
allow init mrvl_gpsd_tmpfs:fifo_file { relabelto };
allow init mrvl_gpsd_tmpfs:file { relabelto };
allow init mrvl_gpsd_tmpfs:lnk_file { relabelto };
allow init mrvl_gpsd_tmpfs:sock_file { relabelto };
allow mrvl_gpsd mrvl_gpsd_exec:file { entrypoint execute getattr open read };
allow mrvl_gpsd mrvl_gpsd_tmpfs:file { read write };
allow system_server mrvl_gpsd:unix_dgram_socket { accept append bind connect create getattr getopt ioctl listen lock name_bind read recv_msg recvfrom send_msg sendto setattr setopt shutdown write };
allow unconfineddomain mrvl_gpsd:binder { call set_context_mgr transfer };
allow unconfineddomain mrvl_gpsd_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mrvl_gpsd_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain mrvl_gpsd_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mrvl_gpsd_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mrvl_gpsd_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain mrvl_gpsd_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app mrvl_gpsd_exec:file { execute getattr open read };
dontaudit init mrvl_gpsd:process { noatsecure };
