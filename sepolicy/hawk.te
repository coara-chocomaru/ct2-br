type hawk;
type hawk_exec;
type hawk_tmpfs;
typeattribute hawk_exec exec_type;

allow debuggerd hawk:process { ptrace };
allow hawk hawk_exec:file { entrypoint execute getattr open read };
allow hawk hawk_tmpfs:file { create getattr open read unlink write };
allow init hawk:file { execute execute_no_trans getattr };
allow init hawk:process { noatsecure rlimitinh siginh transition };
allow init hawk_exec:file { execute getattr open read };
allow init hawk_tmpfs:blk_file { relabelto };
allow init hawk_tmpfs:chr_file { relabelto };
allow init hawk_tmpfs:dir { relabelto };
allow init hawk_tmpfs:fifo_file { relabelto };
allow init hawk_tmpfs:file { relabelto };
allow init hawk_tmpfs:lnk_file { relabelto };
allow init hawk_tmpfs:sock_file { relabelto };
allow recovery hawk_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow unconfineddomain hawk:binder { call set_context_mgr transfer };
allow unconfineddomain hawk_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain hawk_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain hawk_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain hawk_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain hawk_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain hawk_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app hawk_exec:file { execute getattr open read };
dontaudit init hawk:process { noatsecure };
