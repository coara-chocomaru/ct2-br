
allow debuggerd pppmodem:process { ptrace };
allow hawk pppmodem:dir { getattr search };
allow hawk pppmodem:file { open read };
allow imsc pppmodem_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow init pppmodem:process { noatsecure rlimitinh siginh transition };
allow init pppmodem_exec:file { execute getattr open read };
allow init pppmodem_tmpfs:blk_file { relabelto };
allow init pppmodem_tmpfs:chr_file { relabelto };
allow init pppmodem_tmpfs:dir { relabelto };
allow init pppmodem_tmpfs:fifo_file { relabelto };
allow init pppmodem_tmpfs:file { relabelto };
allow init pppmodem_tmpfs:lnk_file { relabelto };
allow init pppmodem_tmpfs:sock_file { relabelto };
allow pppmodem pppmodem_device:chr_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow pppmodem pppmodem_exec:file { entrypoint execute getattr open read };
allow pppmodem pppmodem_tmpfs:file { read write };
allow recovery pppmodem_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow shell pppmodem_device:chr_file { getattr };
allow shell pppmodem_exec:file { getattr };
allow unconfineddomain pppmodem:binder { call set_context_mgr transfer };
allow unconfineddomain pppmodem_device:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain pppmodem_device:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain pppmodem_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain pppmodem_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain pppmodem_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain pppmodem_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain pppmodem_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain pppmodem_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app pppmodem_device:chr_file { getattr };
allow untrusted_app pppmodem_exec:file { execute getattr open read };
dontaudit init pppmodem:process { noatsecure };
