type imsc;
type imsc_tmpfs;

allow debuggerd imsc:process { ptrace };
allow hawk imsc:dir { getattr search };
allow hawk imsc:file { open read };
allow imsc imsc_tmpfs:file { read write };
allow init imsc:process { noatsecure rlimitinh siginh transition };
allow init imsc_tmpfs:blk_file { relabelto };
allow init imsc_tmpfs:chr_file { relabelto };
allow init imsc_tmpfs:dir { relabelto };
allow init imsc_tmpfs:fifo_file { relabelto };
allow init imsc_tmpfs:file { relabelto };
allow init imsc_tmpfs:lnk_file { relabelto };
allow init imsc_tmpfs:sock_file { relabelto };
allow marvelltel imsc:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow marvelltel imsc:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow mediaserver imsc:binder { transfer };
allow netd imsc:fd { use };
allow netd imsc:tcp_socket { accept acceptfrom append bind connect connectto create getattr getopt ioctl listen lock name_bind name_connect newconn node_bind read recv_msg recvfrom send_msg sendto setattr setopt shutdown write };
allow servicemanager imsc:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow servicemanager imsc:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow servicemanager imsc:process { getattr };
allow system_app imsc:unix_stream_socket { accept acceptfrom append bind connect connectto create getattr getopt ioctl listen lock name_bind newconn read recv_msg recvfrom send_msg sendto setattr setopt shutdown write };
allow unconfineddomain imsc:binder { call set_context_mgr transfer };
allow unconfineddomain imsc_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain imsc_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain imsc_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain imsc_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain imsc_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain imsc_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
dontaudit init imsc:process { noatsecure };
