allow appdomain adbd:process { sigchld };
allow domain adbd:fd { use };
allow domain adbd:unix_stream_socket { connectto getattr getopt read shutdown write };
allow hawk adbd:dir { getattr search };
allow hawk adbd:file { open read };
allow init adbd:process { noatsecure rlimitinh siginh transition };
allow init adbd_socket:blk_file { relabelto };
allow init adbd_socket:chr_file { relabelto };
allow init adbd_socket:dir { relabelto };
allow init adbd_socket:fifo_file { relabelto };
allow init adbd_socket:file { relabelto };
allow init adbd_socket:lnk_file { relabelto };
allow init adbd_socket:sock_file { relabelto };
allow runas adbd:process { sigchld };
allow servicemanager adbd:dir { search };
allow servicemanager adbd:process { getattr };
allow shell adbd:process { sigchld };
allow surfaceflinger adbd:fd { use };
allow system_server adbd_socket:sock_file { append getattr ioctl lock open read write };
allow unconfineddomain adbd:binder { call set_context_mgr transfer };
allow unconfineddomain adbd_socket:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain adbd_socket:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain adbd_socket:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain adbd_socket:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain adbd_socket:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain adbd_socket:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app adbd_socket:sock_file { getattr };
dontaudit init adbd:process { noatsecure };
