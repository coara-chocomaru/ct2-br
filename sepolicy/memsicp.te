
allow debuggerd memsicp:process { ptrace };
allow init memsicp:process { noatsecure rlimitinh siginh transition };
allow init memsicp_exec:file { execute getattr open read };
allow init memsicp_tmpfs:blk_file { relabelto };
allow init memsicp_tmpfs:chr_file { relabelto };
allow init memsicp_tmpfs:dir { relabelto };
allow init memsicp_tmpfs:fifo_file { relabelto };
allow init memsicp_tmpfs:file { relabelto };
allow init memsicp_tmpfs:lnk_file { relabelto };
allow init memsicp_tmpfs:sock_file { relabelto };
allow memsicp memsicp_exec:file { entrypoint execute getattr open read };
allow memsicp memsicp_tmpfs:file { read write };
allow unconfineddomain memsicp:binder { call set_context_mgr transfer };
allow unconfineddomain memsicp_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain memsicp_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain memsicp_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain memsicp_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain memsicp_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain memsicp_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app memsicp_exec:file { execute getattr open read };
dontaudit init memsicp:process { noatsecure };
