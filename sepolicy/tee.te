allow mediaserver tee_device:chr_file { append getattr ioctl lock open read write };
allow recovery tee_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow surfaceflinger tee:unix_stream_socket { connectto };
allow surfaceflinger tee_device:chr_file { append getattr ioctl lock open read write };
allow tee tee_data_file:dir { add_name getattr ioctl open read remove_name search write };
allow tee tee_data_file:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow tee tee_device:chr_file { append getattr ioctl lock open read write };
allow tee tee_exec:file { entrypoint execute getattr open read };
allow unconfineddomain tee:binder { call set_context_mgr transfer };
allow unconfineddomain tee_data_file:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain tee_data_file:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
