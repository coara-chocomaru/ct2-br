allow bluetooth pan_result_prop:property_service { set };
allow debuggerd dhcp:process { ptrace };
allow dhcp dhcp_data_file:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow dhcp dhcp_data_file:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow dhcp dhcp_exec:file { entrypoint execute getattr open read };
allow dhcp dhcp_prop:property_service { set };
allow dhcp pan_result_prop:property_service { set };
allow dnsmasq dhcp_data_file:dir { add_name open remove_name search write };
allow dnsmasq dhcp_data_file:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow init dhcp:process { noatsecure rlimitinh siginh transition };
allow init dhcp_data_file:blk_file { relabelto };
allow init dhcp_data_file:chr_file { relabelto };
