type load_g_cali_data;
type load_g_cali_data_exec;
type load_g_cali_data_tmpfs;

allow debuggerd load_g_cali_data:process { ptrace };
allow init load_g_cali_data:process { noatsecure rlimitinh siginh transition };
allow init load_g_cali_data_exec:file { execute getattr open read };
allow init load_g_cali_data_tmpfs:blk_file { relabelto };
allow init load_g_cali_data_tmpfs:chr_file { relabelto };
allow init load_g_cali_data_tmpfs:dir { relabelto };
allow init load_g_cali_data_tmpfs:fifo_file { relabelto };
allow init load_g_cali_data_tmpfs:file { relabelto };
allow init load_g_cali_data_tmpfs:lnk_file { relabelto };
allow init load_g_cali_data_tmpfs:sock_file { relabelto };
allow load_g_cali_data load_g_cali_data_exec:file { entrypoint execute getattr open read };
allow load_g_cali_data load_g_cali_data_tmpfs:file { read write };
allow recovery load_g_cali_data_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow unconfineddomain load_g_cali_data:binder { call set_context_mgr transfer };
allow unconfineddomain load_g_cali_data_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain load_g_cali_data_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain load_g_cali_data_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain load_g_cali_data_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain load_g_cali_data_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain load_g_cali_data_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
dontaudit init load_g_cali_data:process { noatsecure };
