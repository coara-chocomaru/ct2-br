
allow debuggerd env:process { ptrace };
allow env env_exec:file { entrypoint execute getattr open read };
allow env env_tmpfs:file { read write };
allow init env:process { noatsecure rlimitinh siginh transition };
allow init env_exec:file { execute getattr open read };
allow init env_tmpfs:blk_file { relabelto };
allow init env_tmpfs:chr_file { relabelto };
allow init env_tmpfs:dir { relabelto };
allow init env_tmpfs:fifo_file { relabelto };
allow init env_tmpfs:file { relabelto };
allow init env_tmpfs:lnk_file { relabelto };
allow init env_tmpfs:sock_file { relabelto };
allow unconfineddomain env:binder { call set_context_mgr transfer };
allow unconfineddomain env_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain env_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain env_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain env_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain env_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain env_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
dontaudit init env:process { noatsecure };
