allow recovery frp_block_device:blk_file { append getattr ioctl lock open read write };
allow system_server frp_block_device:blk_file { append getattr ioctl lock open read write };
allow unconfineddomain frp_block_device:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain frp_block_device:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
