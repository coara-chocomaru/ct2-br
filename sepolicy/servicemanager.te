allow FMRadiod servicemanager:binder { call transfer };
allow codecIPC_server servicemanager:binder { call impersonate set_context_mgr transfer };
allow debuggerd servicemanager:process { ptrace };
allow domain servicemanager:service_manager { list };
allow hawk servicemanager:dir { getattr search };
allow hawk servicemanager:file { open read };
allow imsc servicemanager:binder { call };
allow init servicemanager:process { noatsecure rlimitinh siginh transition };
allow init servicemanager_exec:file { execute getattr open read };
allow init servicemanager_tmpfs:blk_file { relabelto };
allow init servicemanager_tmpfs:chr_file { relabelto };
allow init servicemanager_tmpfs:dir { relabelto };
allow init servicemanager_tmpfs:fifo_file { relabelto };
allow init servicemanager_tmpfs:file { relabelto };
allow init servicemanager_tmpfs:lnk_file { relabelto };
allow init servicemanager_tmpfs:sock_file { relabelto };
allow marvelltel servicemanager:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow marvelltel servicemanager:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow marvelltel servicemanager:lnk_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow phservice servicemanager:binder { call transfer };
allow recovery servicemanager_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow servicemanager servicemanager_exec:file { entrypoint execute getattr open read };
allow shell servicemanager_exec:file { getattr };
allow unconfineddomain servicemanager:binder { call set_context_mgr transfer };
allow unconfineddomain servicemanager_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain servicemanager_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain servicemanager_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain servicemanager_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain servicemanager_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain servicemanager_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app servicemanager_exec:file { execute getattr open read };
dontaudit init servicemanager:process { noatsecure };
