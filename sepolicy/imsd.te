type imsc_exec;
type imsd_socket;

allow imsc imsc_exec:file { entrypoint execute getattr open read };
allow imsc imsd_socket:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow imsc imsd_socket:fifo_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow imsc imsd_socket:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow imsc imsd_socket:lnk_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow imsc imsd_socket:sock_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow init imsc_exec:file { execute getattr open read };
allow init imsd_socket:blk_file { relabelto };
allow init imsd_socket:chr_file { relabelto };
allow init imsd_socket:dir { relabelto };
allow init imsd_socket:fifo_file { relabelto };
allow init imsd_socket:file { relabelto };
allow init imsd_socket:lnk_file { relabelto };
allow init imsd_socket:sock_file { relabelto };
allow recovery imsc_exec:file { append create getattr ioctl link lock open read relabelfrom relabelto rename setattr unlink write };
allow system_app imsd_socket:sock_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow unconfineddomain imsd_socket:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain imsd_socket:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain imsd_socket:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain imsd_socket:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain imsd_socket:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain imsd_socket:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app imsc_exec:file { execute getattr open read };
allow untrusted_app imsd_socket:sock_file { getattr };
