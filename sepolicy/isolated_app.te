allow debuggerd isolated_app:process { ptrace };
allow init isolated_app:process { noatsecure };
allow init isolated_app_tmpfs:blk_file { relabelto };
allow init isolated_app_tmpfs:chr_file { relabelto };
allow init isolated_app_tmpfs:dir { relabelto };
allow init isolated_app_tmpfs:fifo_file { relabelto };
allow init isolated_app_tmpfs:file { relabelto };
allow init isolated_app_tmpfs:lnk_file { relabelto };
allow init isolated_app_tmpfs:sock_file { relabelto };
allow isolated_app isolated_app_tmpfs:file { execute read write };
allow runas isolated_app:process { dyntransition };
allow unconfineddomain isolated_app:binder { call set_context_mgr transfer };
allow unconfineddomain isolated_app_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain isolated_app_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain isolated_app_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain isolated_app_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain isolated_app_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain isolated_app_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
