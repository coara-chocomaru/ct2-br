allow hawk ueventd:dir { getattr search };
allow hawk ueventd:file { open read };
allow init ueventd:process { noatsecure rlimitinh siginh transition };
allow init ueventd_tmpfs:blk_file { relabelto };
allow init ueventd_tmpfs:chr_file { relabelto };
allow init ueventd_tmpfs:dir { relabelto };
allow init ueventd_tmpfs:fifo_file { relabelto };
allow init ueventd_tmpfs:file { relabelto };
allow init ueventd_tmpfs:lnk_file { relabelto };
allow init ueventd_tmpfs:sock_file { relabelto };
allow marvelltel ueventd:dir { add_name create getattr ioctl link open read remove_name rename reparent rmdir search setattr unlink write };
allow marvelltel ueventd:file { append create getattr ioctl link lock open read rename setattr unlink write };
allow marvelltel ueventd:lnk_file { append create getattr ioctl link lock open read rename setattr unlink write };
allow unconfineddomain ueventd:binder { call set_context_mgr transfer };
allow unconfineddomain ueventd_tmpfs:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain ueventd_tmpfs:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain ueventd_tmpfs:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain ueventd_tmpfs:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain ueventd_tmpfs:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain ueventd_tmpfs:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
dontaudit init ueventd:process { noatsecure };
