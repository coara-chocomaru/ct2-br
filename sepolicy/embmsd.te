type embmsd_socket;

allow init embmsd_socket:blk_file { relabelto };
allow init embmsd_socket:chr_file { relabelto };
allow init embmsd_socket:dir { relabelto };
allow init embmsd_socket:fifo_file { relabelto };
allow init embmsd_socket:file { relabelto };
allow init embmsd_socket:lnk_file { relabelto };
allow init embmsd_socket:sock_file { relabelto };
allow unconfineddomain embmsd_socket:chr_file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain embmsd_socket:dir { add_name append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom remove_name rename reparent rmdir search setattr swapon unlink write };
allow unconfineddomain embmsd_socket:fifo_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain embmsd_socket:file { append audit_access create getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain embmsd_socket:lnk_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow unconfineddomain embmsd_socket:sock_file { append audit_access create execmod execute getattr ioctl link lock mounton open quotaon read relabelfrom rename setattr swapon unlink write };
allow untrusted_app embmsd_socket:sock_file { getattr };
